{
  "name": "claude-swarm-lite",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal Electron GUI that runs several Claude Code sessions in tabs by spawning your local `claude` CLI inside a login shell. It never touches OAuth tokens — each tab is a real `claude` process that inherits the auth you already set up, so everything runs on your normal subscription limits.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "electron-rebuild -f -w node-pty",
    "dist": "electron-builder --mac"
  },
  "license": "MIT",
  "build": {
    "appId": "io.swarm.claude-swarm-lite",
    "productName": "Claude Swarm Lite",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/headless": "^5.5.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3"
  }
}
