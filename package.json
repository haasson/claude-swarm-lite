{
  "name": "claude-swarm-lite",
  "version": "0.6.7",
  "private": true,
  "description": "Minimal Electron GUI for several Claude Code sessions in tabs.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/themes.test.js && node test/keybinds.test.js && node test/preload-contract.test.js && node test/logstore.test.js && node test/updater.test.js",
    "dist": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "release": "node scripts/release.mjs"
  },
  "license": "MIT",
  "build": {
    "appId": "io.swarm.claude-swarm-lite",
    "productName": "Claude Swarm Lite",
    "npmRebuild": false,
    "artifactName": "claude-swarm-lite-${version}-${arch}.${ext}",
    "files": [
      "main.js",
      "git.js",
      "updater.js",
      "updater-core.js",
      "build-info.json",
      "preload.js",
      "renderer/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/@homebridge/node-pty-prebuilt-multiarch/**"
    ],
    "afterPack": "build/afterPack.cjs",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "identity": null,
      "icon": "icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico"
    },
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.13.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/headless": "^5.5.0",
    "@xterm/xterm": "^5.5.0"
  },
  "devDependencies": {
    "electron": "29.4.6",
    "electron-builder": "^26.15.3"
  },
  "overrides": {
    "@noble/hashes": "1.8.0"
  }
}
